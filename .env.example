SITE_URL=https://bosichlegal.cl
ADMIN_USERNAME=nicolas
ADMIN_PASSWORD_HASH=pbkdf2_sha256$iterations$salt$hash
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Dedicated Bosich Legal Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
# Use one server-only key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternative, only if the project still uses the older key format.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CONTENT_TABLE=site_content
SUPABASE_MEMBERS_TABLE=team_members
SUPABASE_MEMBERS_BUCKET=team-member-photos
SUPABASE_CONTACT_SUBMISSIONS_TABLE=contact_submissions
SUPABASE_NEWS_POSTS_TABLE=news_posts
SUPABASE_NEWS_IMAGES_BUCKET=news-images

# Optional contact-form email notifications via Resend.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=nicolas@bosichlegal.cl
CONTACT_FROM_EMAIL=Bosich Legal <contacto@bosichlegal.cl>

# Optional Cloudflare Turnstile captcha. Server-side validation is enabled when TURNSTILE_SECRET_KEY exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_IP_SALT=generate-a-long-random-secret
